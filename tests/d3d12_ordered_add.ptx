.version 8.8
.target sm_89
.address_size 64
.visible .entry ordered_add(.param .u64 output) {
  .reg .b32 %thread, %v;
  .reg .b64 %base, %offset, %ptr;
  ld.param.u64 %base, [output];
  mov.u32 %thread, %tid.x;
  mul.wide.u32 %offset, %thread, 4;
  add.u64 %ptr, %base, %offset;
  ld.global.u32 %v, [%ptr];
  mad.lo.u32 %v, %v, 3, 7;
  st.global.u32 [%ptr], %v;
  ret;
}
